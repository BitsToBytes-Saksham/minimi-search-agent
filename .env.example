# Free-tier option: create your own key at https://aistudio.google.com/api-keys
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: free key gives 1,000 basic searches/month. Empty uses free keyless search.
TAVILY_API_KEY=
# To use OpenAI instead, set AI_PROVIDER=openai and provide a funded key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
PORT=3000
DATA_DIR=./data
